{
  "purpose": "Contract-authored test inputs, NOT production/API output; TS defensive projection and Rust typed wire are distinct acceptance domains",
  "schema_contract": 2,
  "factory": {
    "enabled": false,
    "mode": "original",
    "target": "both",
    "ambient": {
      "intensity": 1,
      "color": "#ffffff"
    },
    "point_light": {
      "enabled": true,
      "x": 0.5,
      "y": 0.5,
      "radius": 0.75,
      "softness": 0.8,
      "intensity": 0.85,
      "color": "#fff1d2"
    }
  },
  "cases": [
    {
      "id": "legacy-omitted",
      "input": {
        "schema_version": 2
      },
      "expected_relighting": null,
      "runtime_wire_accepted": true,
      "archive_valid": true
    },
    {
      "id": "known-root-null",
      "input": {
        "schema_version": 2,
        "relighting": null
      },
      "expected_relighting": null,
      "runtime_wire_accepted": true,
      "archive_valid": true
    },
